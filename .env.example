# Supabase (required for balance and betting APIs)
# Create a project at https://supabase.com and run: npm run db:show-migration then apply in SQL editor
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Polygon mainnet
# NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-rpc.com
# NEXT_PUBLIC_POLYGON_TREASURY_ADDRESS=0x...
# POLYGON_TREASURY_SECRET_KEY=0x...  # server-only, for withdrawals

# WalletConnect (optional, for ConnectKit)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-project-id
